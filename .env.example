# =============================================================================
# 📋 ENV Template — Cubículo Digital
# =============================================================================
# Copia este archivo como `.env` y completa los valores reales.
# NUNCA comitear `.env` con secrets reales.
# =============================================================================

# -----------------------------
# Web / Next.js / Apollo Client
# -----------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql

# -----------------------------
# Node / App Render
# -----------------------------
NODE_ENV=development
PORT=4000

# -----------------------------
# JWT Secret (generar con: openssl rand -base64 32)
# -----------------------------
JWT_SECRET=your_jwt_secret_here

# -----------------------------
# PostgreSQL Supabase
# -----------------------------
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# -----------------------------
# API / Redis URL (Upstash)
# -----------------------------
REDIS_URL=redis://default:password@host:port

# -----------------------------
# SOCIAL AUTH / Google Client ID
# -----------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# -----------------------------
# IA / Groq API Key (https://console.groq.com/keys)
# -----------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
